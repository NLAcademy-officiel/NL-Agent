generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String?
  passwordHash   String?
  role           UserRole     @default(MEMBER)
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Organization {
  id                  String                @id @default(cuid())
  name                String
  slug                String                @unique
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  agents              Agent[]
  channels            Channel[]
  subscriptions       ChariowSubscription[]
  contacts            Contact[]
  conversations       Conversation[]
  leads               Lead[]
  paymentInstructions PaymentInstruction[]
  usage               Usage[]
  users               User[]
}

model Agent {
  id             String           @id @default(cuid())
  name           String
  description    String?
  systemPrompt   String?
  status         AgentStatus      @default(ACTIVE)
  organizationId String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  knowledge      AgentKnowledge[]
  conversations  Conversation[]

  @@index([organizationId])
}

model Channel {
  id             String         @id @default(cuid())
  type           ChannelType
  name           String
  organizationId String
  widgetId       String?         @unique
  isActive       Boolean        @default(true)
  configuration  Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations  Conversation[]

  @@index([organizationId])
  @@index([type])
}

model Contact {
  id             String         @id @default(cuid())
  organizationId String
  name           String?
  email          String?
  phone          String?
  whatsappId     String?
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  visitorId      String?
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations  Conversation[]
  lead           Lead?
  paymentProofs  PaymentProof[]

  @@index([organizationId])
  @@index([phone])
  @@index([whatsappId])
  @@index([visitorId])
}

model Lead {
  id             String       @id @default(cuid())
  organizationId String
  contactId      String       @unique
  status         LeadStatus   @default(NEW)
  source         String?
  notes          String?
  score          Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
}

model Conversation {
  id             String             @id @default(cuid())
  organizationId String
  agentId        String?
  channelId      String
  contactId      String
  status         ConversationStatus @default(OPEN)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  agent          Agent?             @relation(fields: [agentId], references: [id])
  channel        Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  contact        Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@index([organizationId])
  @@index([contactId])
  @@index([channelId])
  @@index([agentId])
}

model Message {
  id             String              @id @default(cuid())
  conversationId String
  direction      MessageDirection
  type           MessageType         @default(TEXT)
  senderType     SenderType
  content        String?
  externalId     String?
  metadata       Json?
  createdAt      DateTime            @default(now())
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments    MessageAttachment[]

  @@index([conversationId])
  @@index([externalId])
}

model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  url       String
  fileName  String?
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model AgentKnowledge {
  id        String   @id @default(cuid())
  agentId   String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

model PaymentInstruction {
  id             String         @id @default(cuid())
  organizationId String
  title          String
  description    String?
  paymentLink    String?
  accountNumber  String?
  instructions   String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proofs         PaymentProof[]

  @@index([organizationId])
}

model PaymentProof {
  id                   String             @id @default(cuid())
  paymentInstructionId String
  contactId            String
  amount               Decimal?
  currency             String?
  proofUrl             String
  status               PaymentStatus      @default(SUBMITTED)
  verifiedBy           String?
  verifiedAt           DateTime?
  notes                String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  contact              Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  paymentInstruction   PaymentInstruction @relation(fields: [paymentInstructionId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([status])
}

model ChariowSubscription {
  id             String             @id @default(cuid())
  organizationId String
  externalId     String?
  productId      String?
  planName       String?
  status         SubscriptionStatus @default(TRIAL)
  startedAt      DateTime?
  expiresAt      DateTime?
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([externalId])
  @@index([status])
}

model Usage {
  id             String       @id @default(cuid())
  organizationId String
  periodStart    DateTime
  periodEnd      DateTime
  messages       Int          @default(0)
  aiRequests     Int          @default(0)
  conversations  Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum AgentStatus {
  ACTIVE
  INACTIVE
}

enum ChannelType {
  WEBSITE
  WHATSAPP
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  NEGOTIATION
  WON
  LOST
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  OTHER
}

enum SenderType {
  CONTACT
  AGENT
  HUMAN
  SYSTEM
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  TRIAL
}
